    // Calculate the Root
    const calculatedRoot = await tree.getRoot();

    console.log("\n==================================================");
    console.log(" 🧪 MANUAL TEST CALCULATED ROOT:");
    console.log(" " + calculatedRoot);
    console.log("==================================================\n");
}

runManualTest().catch(console.error);
