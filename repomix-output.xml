  .badge-green { background: rgba(34,197,94,.1); border: 1px solid rgba(34,197,94,.2); color: #4ade80; }
  .badge-orange { background: var(--orange-lite); border: 1px solid rgba(249,115,22,.25); color: #fb923c; }
  .badge-cyan { background: var(--cyan-lite); border: 1px solid oklch(0.72 0.18 200/.25); color: var(--cyan); }
  .badge-red { background: rgba(239,68,68,.1); border: 1px solid rgba(239,68,68,.2); color: #f87171; }

