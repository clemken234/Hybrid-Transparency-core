  }
  .kk-input::placeholder { color: var(--text3); }
  .kk-input:focus {
    border-color: rgba(249,115,22,.5);
    box-shadow: 0 0 0 3px rgba(249,115,22,.08);
  }

  /* Action buttons (wallet home row) */
  .action-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    background: none;
    border: none;
    font-family: 'Space Grotesk', sans-serif;
  }
  .action-btn-icon {
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: var(--bg3);
    border: 1.5px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all .18s;
    color: var(--text);
  }
  .action-btn:hover .action-btn-icon {
    background: var(--bg4);
    border-color: var(--border2);
    color: #fff;
  }
  .action-btn span {
    font-size: 10px;
    font-weight: 700;
    color: var(--text2);
    letter-spacing: .05em;
    text-transform: uppercase;
  }

  /* Buttons */
  .btn-kk {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 16px 28px;
    border: none;
    border-radius: 10px;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: .06em;
    cursor: pointer;
    transition: all .18s;
    text-transform: uppercase;
  }
  .btn-orange {
    background: var(--orange);
    color: #fff;
    box-shadow: 0 4px 20px rgba(249,115,22,.3);
  }
  .btn-orange:hover { background: #fb8c3a; box-shadow: 0 4px 28px rgba(249,115,22,.45); transform: translateY(-1px); }
  .btn-orange:disabled { opacity: .35; cursor: not-allowed; transform: none; }
  .btn-ghost {
    background: var(--bg3);
    border: 1.5px solid var(--border);
    color: var(--text2);
