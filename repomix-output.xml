  .cred-perspective { perspective: 1100px; }
  .cred-inner {
    transition: transform .65s cubic-bezier(.4,0,.2,1);
    transform-style: preserve-3d;
    -webkit-transform-style: preserve-3d;
    width: 100%;
    height: 100%;
    position: relative;
  }
  .cred-inner.flipped { transform: rotateY(180deg); }
  .cred-face {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    position: absolute;
    inset: 0;
    border-radius: 22px;
    overflow: hidden;
    will-change: transform;
  }
  .cred-back { transform: rotateY(180deg) translateZ(1px); -webkit-transform: rotateY(180deg) translateZ(1px); }
  .holo {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 30%, rgba(255,255,255,.06) 50%, transparent 70%);
    background-size: 600px 100%;
    animation: shimmer 4s ease-in-out infinite;
    pointer-events: none;
    border-radius: inherit;
  }

  /* Bottom nav */
  .bottom-nav {
    position: fixed;
    bottom: 24px;
    left: 20px;
    right: 20px;
    background: rgba(26, 26, 26, 0.7);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-radius: 24px;
    display: flex;
    justify-content: space-around;
    align-items: center;
    padding: 12px 16px;
    z-index: 100;
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    border: 1.5px solid rgba(255,255,255,0.08);
  }
  .nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    color: #8E8E93;
    cursor: pointer;
    transition: all .2s;
    flex: 1;
    padding: 6px 0;
  }
  .nav-item.active { color: var(--orange); }
  .nav-item span { font-size: 11px; font-weight: 500; letter-spacing: .02em; font-family: var(--font-sans); text-transform: capitalize; }

  /* Sidebar */
  .kk-sidebar {
    width: 240px;
    background: var(--bg2);
    border-right: 1.5px solid var(--border);
    height: 100vh;
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
  }
  .sidebar-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 14px;
    border-radius: 12px;
    border: 1.5px solid transparent;
    cursor: pointer;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 13px;
    color: var(--text2);
    transition: all .18s;
    width: 100%;
    background: none;
    text-align: left;
  }
  .sidebar-item:hover { background: rgba(255,255,255,.04); color: var(--text); }
  .sidebar-item.active { background: var(--orange-lite); border-color: rgba(249,115,22,.25); color: var(--orange); }

  /* Toast */
  .kk-toast {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 500;
    animation: fadeUp .3s ease both;
  }

  /* Step dot */
  .step-dot {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all .35s;
  }
  .step-done { background: rgba(34,197,94,.15); border: 1.5px solid rgba(34,197,94,.3); }
  .step-active { background: var(--orange-lite); border: 1.5px solid rgba(249,115,22,.35); }
  .step-idle { background: rgba(255,255,255,.04); border: 1.5px solid var(--border); }
}

/* Animations */
@keyframes fadeUp { from { opacity:0; transform:translateY(14px) } to { opacity:1; transform:translateY(0) } }
@keyframes fadeIn { from { opacity:0 } to { opacity:1 } }
@keyframes pulse { 0%,100% { opacity:1 } 50% { opacity:.35 } }
@keyframes spin { to { transform:rotate(360deg) } }
@keyframes shimmer { 0% { background-position:-600px 0 } 100% { background-position:600px 0 } }
@keyframes popIn { 0% { opacity:0; transform:scale(.92) } 100% { opacity:1; transform:scale(1) } }
@keyframes scan { 0%,100% { top:0 } 50% { top:calc(100% - 2px) } }

.anim-fade-up { animation: fadeUp .45s ease both; }
.anim-fade-in { animation: fadeIn .3s ease both; }
.anim-pop { animation: popIn .35s cubic-bezier(.34,1.56,.64,1) both; }
.anim-spin { animation: spin 1s linear infinite; }
.anim-pulse { animation: pulse 2s ease-in-out infinite; }
.scan-line { position: absolute; animation: scan 2.5s ease-in-out infinite; }
</file>

