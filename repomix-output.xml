    {/* Active partner */}
    <div style={{ background: "var(--bg2)", border: "1.5px solid oklch(0.72 0.18 200/.18)", borderRadius: 18, padding: 16 }}>
      <div style={{ display: "flex", alignItems: "center", gap: 14 }}>
