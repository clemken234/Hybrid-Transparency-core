<file path="src/app/globals.css">
@import "tailwindcss";

@theme {
  --color-orange-primary: #F97316;
  --color-background: #0d0f14;
  --color-foreground: #eef0f8;
  --font-sans: 'Space Grotesk', system-ui, sans-serif;
  --font-mono: 'JetBrains Mono', monospace;
}

@layer base {
  *, *::before, *::after { box-sizing: border-box; }

  :root {
    --bg: #0d0f14;
    --bg2: #13161e;
    --bg3: #1a1d27;
    --bg4: #20243a;
    --border: rgba(255,255,255,0.07);
    --border2: rgba(255,255,255,0.12);
    --orange: #F97316;
    --orange-lite: rgba(249,115,22,0.15);
    --orange-glow: rgba(249,115,22,0.25);
    --cyan: oklch(0.72 0.18 200);
    --cyan-lite: oklch(0.72 0.18 200/0.12);
    --green: #22c55e;
    --red: #ef4444;
    --text: #eef0f8;
    --text2: rgba(238,240,248,0.55);
    --text3: rgba(238,240,248,0.28);
  }

  html, body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Space Grotesk', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  ::-webkit-scrollbar { width: 3px; }
  ::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 2px; }
}

@layer components {
  /* Hero layout */
  .hero-layout {
    display: flex;
    flex-direction: column;
    gap: 48px;
    justify-content: center;
    padding: 20px 24px 32px;
    flex: 1;
  }
  .hero-visual {
    display: none;
    flex-direction: column;
    align-items: center;
  }
  @media (min-width: 768px) {
    .hero-layout { flex-direction: row; align-items: center; }
    .hero-visual { display: flex; }
  }

  /* Grid background */
  .grid-bg {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background-image:
      linear-gradient(rgba(255,255,255,.022) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.022) 1px, transparent 1px);
    background-size: 44px 44px;
  }
  .grid-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 50% at 50% 0%, oklch(0.72 0.18 200 / 0.07) 0%, transparent 65%),
      radial-gradient(ellipse 50% 40% at 85% 85%, rgba(249,115,22,.05) 0%, transparent 60%);
  }

  /* Cards */
  .kk-card {
    background: var(--bg2);
    border: 1.5px solid var(--border);
    border-radius: 24px;
  }
  .kk-card-sm {
    background: var(--bg2);
    border: 1.5px solid var(--border);
    border-radius: 16px;
  }

  /* Input */
  .kk-input {
    width: 100%;
    background: var(--bg3);
    border: 1.5px solid var(--border);
    border-radius: 16px;
    padding: 14px 16px;
    font-size: 14px;
    font-family: 'Space Grotesk', sans-serif;
    color: var(--text);
    outline: none;
    transition: border-color .2s, box-shadow .2s;
  }
  .kk-input::placeholder { color: var(--text3); }
  .kk-input:focus {
    border-color: rgba(249,115,22,.5);
    box-shadow: 0 0 0 3px rgba(249,115,22,.08);
  }

  /* Action buttons (wallet home row) */
  .action-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    background: none;
    border: none;
    font-family: 'Space Grotesk', sans-serif;
  }
  .action-btn-icon {
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: var(--bg3);
    border: 1.5px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all .18s;
    color: var(--text);
  }
  .action-btn:hover .action-btn-icon {
    background: var(--bg4);
    border-color: var(--border2);
    color: #fff;
  }
  .action-btn span {
    font-size: 10px;
    font-weight: 700;
    color: var(--text2);
    letter-spacing: .05em;
    text-transform: uppercase;
  }

  /* Buttons */
  .btn-kk {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 16px 28px;
    border: none;
    border-radius: 10px;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: .06em;
    cursor: pointer;
    transition: all .18s;
    text-transform: uppercase;
  }
  .btn-orange {
    background: var(--orange);
    color: #fff;
    box-shadow: 0 4px 20px rgba(249,115,22,.3);
  }
  .btn-orange:hover { background: #fb8c3a; box-shadow: 0 4px 28px rgba(249,115,22,.45); transform: translateY(-1px); }
  .btn-orange:disabled { opacity: .35; cursor: not-allowed; transform: none; }
  .btn-ghost {
    background: var(--bg3);
    border: 1.5px solid var(--border);
    color: var(--text2);
  }
  .btn-ghost:hover { background: var(--bg4); border-color: var(--border2); color: var(--text); }
  .btn-red {
    background: rgba(239,68,68,.1);
    border: 1.5px solid rgba(239,68,68,.2);
    color: #f87171;
  }
  .btn-red:hover { background: rgba(239,68,68,.18); }
  .btn-cyan {
    background: var(--cyan-lite);
    border: 1.5px solid oklch(0.72 0.18 200 / .3);
    color: var(--cyan);
  }
  .btn-cyan:hover { background: oklch(0.72 0.18 200 / .2); box-shadow: 0 0 20px oklch(0.72 0.18 200 / .15); }

  /* Badges */
  .badge-kk {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    border-radius: 99px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .badge-green { background: rgba(34,197,94,.1); border: 1px solid rgba(34,197,94,.2); color: #4ade80; }
  .badge-orange { background: var(--orange-lite); border: 1px solid rgba(249,115,22,.25); color: #fb923c; }
  .badge-cyan { background: var(--cyan-lite); border: 1px solid oklch(0.72 0.18 200/.25); color: var(--cyan); }
  .badge-red { background: rgba(239,68,68,.1); border: 1px solid rgba(239,68,68,.2); color: #f87171; }

  /* Dot */
  .dot-green { background: #22c55e; box-shadow: 0 0 8px #22c55e; }
  .dot-orange { background: var(--orange); box-shadow: 0 0 8px var(--orange); }

  /* Label */
  .kk-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--text3);
  }

  /* Credential card flip */
  .cred-perspective { perspective: 1100px; }
  .cred-inner {
    transition: transform .65s cubic-bezier(.4,0,.2,1);
    transform-style: preserve-3d;
    -webkit-transform-style: preserve-3d;
    width: 100%;
    height: 100%;
    position: relative;
  }
  .cred-inner.flipped { transform: rotateY(180deg); }
  .cred-face {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    position: absolute;
    inset: 0;
    border-radius: 22px;
    overflow: hidden;
    will-change: transform;
  }
  .cred-back { transform: rotateY(180deg) translateZ(1px); -webkit-transform: rotateY(180deg) translateZ(1px); }
  .holo {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 30%, rgba(255,255,255,.06) 50%, transparent 70%);
    background-size: 600px 100%;
    animation: shimmer 4s ease-in-out infinite;
    pointer-events: none;
    border-radius: inherit;
  }

  /* Bottom nav */
  .bottom-nav {
    position: fixed;
    bottom: 24px;
    left: 20px;
    right: 20px;
    background: rgba(26, 26, 26, 0.7);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-radius: 24px;
    display: flex;
    justify-content: space-around;
    align-items: center;
    padding: 12px 16px;
    z-index: 100;
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    border: 1.5px solid rgba(255,255,255,0.08);
  }
  .nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    color: #8E8E93;
    cursor: pointer;
    transition: all .2s;
    flex: 1;
    padding: 6px 0;
  }
  .nav-item.active { color: var(--orange); }
  .nav-item span { font-size: 11px; font-weight: 500; letter-spacing: .02em; font-family: var(--font-sans); text-transform: capitalize; }

  /* Sidebar */
  .kk-sidebar {
    width: 240px;
    background: var(--bg2);
    border-right: 1.5px solid var(--border);
    height: 100vh;
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
  }
  .sidebar-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 14px;
    border-radius: 12px;
    border: 1.5px solid transparent;
    cursor: pointer;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 13px;
    color: var(--text2);
    transition: all .18s;
    width: 100%;
    background: none;
    text-align: left;
  }
  .sidebar-item:hover { background: rgba(255,255,255,.04); color: var(--text); }
  .sidebar-item.active { background: var(--orange-lite); border-color: rgba(249,115,22,.25); color: var(--orange); }

  /* Toast */
  .kk-toast {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 500;
    animation: fadeUp .3s ease both;
  }

  /* Step dot */
  .step-dot {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all .35s;
  }
  .step-done { background: rgba(34,197,94,.15); border: 1.5px solid rgba(34,197,94,.3); }
  .step-active { background: var(--orange-lite); border: 1.5px solid rgba(249,115,22,.35); }
  .step-idle { background: rgba(255,255,255,.04); border: 1.5px solid var(--border); }
}

/* Animations */
@keyframes fadeUp { from { opacity:0; transform:translateY(14px) } to { opacity:1; transform:translateY(0) } }
@keyframes fadeIn { from { opacity:0 } to { opacity:1 } }
@keyframes pulse { 0%,100% { opacity:1 } 50% { opacity:.35 } }
@keyframes spin { to { transform:rotate(360deg) } }
@keyframes shimmer { 0% { background-position:-600px 0 } 100% { background-position:600px 0 } }
@keyframes popIn { 0% { opacity:0; transform:scale(.92) } 100% { opacity:1; transform:scale(1) } }
@keyframes scan { 0%,100% { top:0 } 50% { top:calc(100% - 2px) } }

.anim-fade-up { animation: fadeUp .45s ease both; }
.anim-fade-in { animation: fadeIn .3s ease both; }
.anim-pop { animation: popIn .35s cubic-bezier(.34,1.56,.64,1) both; }
.anim-spin { animation: spin 1s linear infinite; }
.anim-pulse { animation: pulse 2s ease-in-out infinite; }
.scan-line { position: absolute; animation: scan 2.5s ease-in-out infinite; }
