<file path="src/app/wallet/page.tsx">
"use client";

import React, { useState, useEffect, useRef } from "react";
import { useRouter } from "next/navigation";
import jsQR from "jsqr";
import { Html5Qrcode } from "html5-qrcode";
import { QRCodeSVG } from "qrcode.react";
import { ethers } from "ethers";
import { fetchRoot, getContract, fetchAllLeaves, computeLeanIMTPath } from "@/utils/chain";
import mockCitizens from "@/lib/mockData";

const ADMIN_PUBLIC_KEY = "0x6B53a6b3ED6649C13de2a7cc89CCB79F1A70923F ";

function verifyAdminCredential(adminPublicKey: string, credentialDataString: string, adminSignature: string): boolean {
  try {
    const messageHash = ethers.id(credentialDataString);
    const recoveredAddress = ethers.recoverAddress(messageHash, adminSignature);
    return recoveredAddress.toLowerCase() === adminPublicKey.toLowerCase();
  } catch (error) {
    console.error("Signature parsing verification failed:", error);
    return false;
  }
}

/* ── Logo ── */
