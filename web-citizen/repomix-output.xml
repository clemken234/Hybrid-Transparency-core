+  const bytes = crypto.getRandomValues(new Uint8Array(32));
+  const raw = "0x" + Array.from(bytes).map(b => b.toString(16).padStart(2, "0")).join("");
+  const newSecret = clampToField(raw);
+  localStorage.setItem('lto_secret', newSecret);
+  return newSecret;
+}
